<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>CursorFollowWin</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embed the app icon as a Win32 resource in the exe. Gives the executable a real icon in
         Explorer / taskbar / Alt-Tab, and lets the tray load its icon from the exe itself
         (TrayIconService) without depending on a loose Assets\AppIcon.ico — which `dotnet publish`
         does NOT copy, so the installed build would otherwise show the generic system icon. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Single source of truth for the product version. The About dialog reads the assembly
         version; the WiX installer (installer/Package.wxs) reads FileVersion via package.ps1.
         Bump this to drive a MajorUpgrade. Pre-1.0 while the Windows port is in packaging/hardening. -->
    <Version>0.4.0</Version>
    <FileVersion>0.4.0.0</FileVersion>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <InformationalVersion>0.4.0</InformationalVersion>
    <Company>Logan Rupe</Company>
    <Product>CursorFollow</Product>
    <Authors>Logan Rupe</Authors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x86'">
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- The app project sits at the repo's CursorFollowWin/ root and globs **/*.cs by default, which
       would otherwise sweep in (and double-compile) the sibling Shared/Capture/tests projects nested
       beneath it. Exclude those trees; they build as their own assemblies referenced below. -->
  <ItemGroup>
    <Compile Remove="Shared\**\*.cs" />
    <Compile Remove="Capture\**\*.cs" />
    <Compile Remove="Output\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Page Remove="Shared\**\*.xaml" />
    <Page Remove="Capture\**\*.xaml" />
    <Page Remove="Output\**\*.xaml" />
    <Page Remove="tests\**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Shared\CursorFollowWin.Shared.csproj" />
    <ProjectReference Include="Capture\CursorFollowWin.Capture.csproj" />
    <ProjectReference Include="Output\CursorFollowWin.Output.csproj" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup
    Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup
    Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Trimming is intentionally OFF. WinUI 3 / XAML / Win2D resolve types via reflection and
         XAML metadata, which the IL trimmer cannot see and silently removes, producing a build
         that crashes at runtime (e.g. missing XAML types). ReadyToRun gives the startup-speed
         win without the trimming risk; the self-contained payload is larger but reliable. -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <!-- WinUI 3 unpackaged self-contained publish drops the app's root resources PRI
       ($(TargetName).pri): the per-project PRIs of referenced libraries (Capture/Output) are
       copied as ordinary project outputs, but the app's own generated PRI is not added to the
       publish item set. Without it the runtime cannot resolve ANY ms-appx:/// resource — the
       app launches but throws XamlParseException locating MainWindow.xaml from the Output
       assembly. The normal build OutDir always holds a freshly generated PRI by publish time
       (publish builds first), so copy it across. See README "Publish" notes. -->
  <Target Name="_CopyAppPriToPublish" AfterTargets="Publish"
          Condition="Exists('$(OutDir)$(TargetName).pri')">
    <Copy SourceFiles="$(OutDir)$(TargetName).pri"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied $(TargetName).pri into publish output (WinUI PRI fix)." />
  </Target>
</Project>